{
  "name": "@openstreetlightmapper/geo",
  "version": "0.1.0",
  "private": true,
  "description": "Shared WGS84 region validation and measurement (no dependencies).",
  "type": "module",
  "main": "./dist/geo.js",
  "types": "./dist/geo.d.ts",
  "exports": {
    ".": {
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

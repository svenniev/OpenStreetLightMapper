# OpenStreetLightMapper server example environment.
# Copy to `.env` and adjust. Never commit real secrets.
# Placeholders only.

# Port the Express server listens on. The Vite dev proxy forwards /api here.
PORT=3001

# Reserved for a future milestone. No connection is established in Milestone 0.
# Example format only: mongodb://localhost:27017/openstreetlightmapper
MONGODB_URI=mongodb://localhost:27017/openstreetlightmapper

# Mapillary access token for server-side image search (POST /api/mapillary/images/search).
# A client access token from https://www.mapillary.com/dashboard/developers is suitable.
# This is separate from the browser viewer token (VITE_MAPILLARY_CLIENT_TOKEN):
# configuring one does not configure the other, and the server never reads the
# frontend environment file. Placeholders only.
MAPILLARY_ACCESS_TOKEN=your-mapillary-access-token

# OpenStreetLightMapper server example environment.
# Copy to `.env` and adjust. Never commit real secrets.
# Placeholders only.

# Port the Express server listens on. The Vite dev proxy forwards /api here.
PORT=3001

# Reserved for a future milestone. No connection is established in Milestone 0.
# Example format only: mongodb://localhost:27017/openstreetlightmapper
MONGODB_URI=mongodb://localhost:27017/openstreetlightmapper

# Mapillary access token for server-side image search (POST /api/mapillary/images/search).
# A client access token from https://www.mapillary.com/dashboard/developers is suitable.
# This is separate from the browser viewer token (VITE_MAPILLARY_CLIENT_TOKEN):
# configuring one does not configure the other, and the server never reads the
# frontend environment file. Placeholders only.
MAPILLARY_ACCESS_TOKEN=your-mapillary-access-token

# Overpass API endpoint for server-side street retrieval (POST /api/streets/search).
# Default is the public instance, suitable for modest local development only:
# public Overpass is shared infrastructure. For heavier use, deploy a self-hosted
# instance and point this setting at it. See https://dev.overpass-api.de/overpass-doc/en/preface/commons.html
# When the default instance is busy (timeouts, 5xx), another public instance from
# the "Public Overpass API instances" list on https://wiki.openstreetmap.org/wiki/Overpass_API
# can be used here instead.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Meta Model API key for server-side SAM detection (POST /api/detection/sam).
# Server-only: never a VITE_* variable, never in the frontend bundle, logs, or
# responses. Create one at https://dev.meta.ai/ (select the account/project,
# claim hackathon credits if applicable), set it here, and restart the server.
# Only a successful image inference proves access; a present-but-wrong key or
# missing entitlement surfaces as SAM_AUTH_ERROR on explicit Test/Detect work.
# Placeholders only.
MODEL_API_KEY=your-meta-model-api-key

# SAM model name for detection. Default is sam-3.1 (hosted Segment Anything
# Model); override only if Meta publishes a successor you have access to.
# SAM_MODEL=sam-3.1

# Deadline in milliseconds for one SAM inference request (10s..300s).
# SAM_TIMEOUT_MS=120000

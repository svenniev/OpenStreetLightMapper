# OpenStreetLightMapper web example environment.
# Copy to `.env` and adjust. Never commit real secrets.
# Placeholders only.
#
# IMPORTANT: every VITE_* value is embedded in the public browser bundle.
# Use only a Mapillary client access token intended for client-side use
# (from https://www.mapillary.com/dashboard/developers).
# Never put a private application secret in a VITE_* variable.

VITE_MAPILLARY_CLIENT_TOKEN=your-mapillary-client-token

# Optional overrides for the OpenStreetMap basemap.
# Defaults are the standard OSM raster tiles + OSM contributor attribution.
# VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

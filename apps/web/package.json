{
  "name": "@openstreetlightmapper/web",
  "version": "0.1.0",
  "private": true,
  "description": "React workspace UI for OpenStreetLightMapper (Milestone 1: region search).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/lib/**/*.test.ts\" \"src/features/**/*.test.ts\""
  },
  "dependencies": {
    "@openstreetlightmapper/geo": "*",
    "leaflet": "^1.9.4",
    "mapillary-js": "^4.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
